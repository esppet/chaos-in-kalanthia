// ROOM 40 — Star destroyer jail cell (Act 2)

function room_AfterFadeIn()
{
  gCurrentAct = ACT_STAR_DESTROYER;
  player.Say("Tractor beam. They pulled me inside some kind of warship.");
}

function hAirDuctPanel_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("An access panel next to an air duct. The wiring looks exposed.");
}

function hAirDuctPanel_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  if (player.HasInventory(INV_WIRE))
  {
    // TODO: Hot-wire minigame / puzzle
    player.Say("Panel bypassed. The duct is open.");
    player.ChangeRoom(ROOM_SD_VENTS);
  }
  else
  {
    player.Say("I need something to bridge the circuit — wire, maybe.");
  }
}