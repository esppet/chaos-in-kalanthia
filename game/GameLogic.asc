// Core game logic: acts, timer, ship components, endings

int gCurrentAct = 1;
int gGameEnding = 0;
int gRobertRescued = 0;
int gAnnitaOnboard = 0;
int gRobertOnboard = 0;
int gRingGifted = 0;
int gShipComponentsFound = 0;

//=============================================================================
// Intro
//=============================================================================

function PlayIntroSequence()
{
  // TODO: Replace with animated intro / voice-over when assets exist.
  // Meteor strike on Kalanthia — colony devastated, military base in ruins.
  Display("Kalanthia, an off-world colony in the Blade Runner universe.");
  Wait(120);
  Display("A massive meteor strike has shattered the planet's surface.");
  Wait(120);
  Display("Replicant soldier Russell awakens among the wreckage of the military base.");
  Wait(120);
  Display("His only hope of survival: find a working spaceship and escape.");
  Wait(120);
}

//=============================================================================
// Act 1 — Zero collapse timer
//=============================================================================

function StartZeroCollapseTimer()
{
  if (GetTimerPos(TIMER_ZERO_COLLAPSE) > 0)
    return;

  SetTimer(TIMER_ZERO_COLLAPSE, ZERO_COLLAPSE_SECONDS);
  gIconbar.Visible = true;
  player.Say("That building is coming down. I don't have much time.");
}

function StopZeroCollapseTimer()
{
  SetTimer(TIMER_ZERO_COLLAPSE, 0);
}

function OnZeroCollapseExpired()
{
  // Game over — Robert lost, building collapsed
  StopZeroCollapseTimer();
  Display("The megacomplex collapses before you reach Robert. GAME OVER.");
  Wait(200);
  RestartGame();
}

//=============================================================================
// Ship components
//=============================================================================

function HasAllShipComponents()
{
  return (gShipComponentsFound >= 3);
}

function CheckShipReady()
{
  if (HasAllShipComponents())
  {
    SetGlobalInt(FLAG_SHIP_READY, 1);
    player.Say("The ship is ready. I need to decide who comes with me.");
  }
}

function RegisterShipComponent(String token)
{
  if (!Game.DoOnceOnly(token))
    return;

  gShipComponentsFound++;
  CheckShipReady();
}

//=============================================================================
// Endings
//=============================================================================

function TriggerEnding(GameEnding ending)
{
  gGameEnding = ending;

  if (ending == eEndingBadGasChamber)
  {
    player.ChangeRoom(ROOM_EARTH_GAS_CHAMBER);
  }
  else if (ending == eEndingGoodSurvivors)
  {
    player.ChangeRoom(ROOM_EARTH_TRIBUNAL);
  }
  else if (ending == eEndingGoodRomance)
  {
    player.ChangeRoom(ROOM_EARTH_TRIBUNAL);
  }
}

function ResolveEarthEnding()
{
  if (gAnnitaOnboard && gRobertOnboard)
  {
    if (gRingGifted)
      TriggerEnding(eEndingGoodRomance);
    else
      TriggerEnding(eEndingGoodSurvivors);
  }
  else
  {
    TriggerEnding(eEndingBadGasChamber);
  }
}