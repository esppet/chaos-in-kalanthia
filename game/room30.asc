// ROOM 30 — Spaceship hangar (Act 1 finale)

function hSpaceship_Look(Hotspot *thisHotspot, CursorMode mode)
{
  if (HasAllShipComponents())
    player.Say("A battered but functional transport. She'll fly.");
  else
    player.Say("The ship is here, but she's missing critical components.");
}

function hSpaceship_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  if (!HasAllShipComponents())
  {
    player.Say("I still need a fuel cell and other vital components.");
    return;
  }

  // TODO: Dialogue tree — convince Annita to leave Kalanthia
  // Player choice: bring Annita + Robert, or leave alone
  player.Say("The ship is ready. Time to leave this dead world.");
  gCurrentAct = ACT_STAR_DESTROYER;
  // player.ChangeRoom(ROOM_SD_JAIL);
}

function hAnnita_Talk(Character *thisCharacter, CursorMode mode)
{
  if (!gRobertRescued)
  {
    player.Say("I need to save her son first. She won't help me until then.");
    return;
  }

  if (!Game.DoOnceOnly(FLAG_ANNITA_ALLIED))
  {
    player.Say("Annita: 'You saved Robert. I'll tell you where to find what you need.'");
    Game.SetGlobalInt(FLAG_ANNITA_ALLIED, 1);
  }
  else
  {
    player.Say("Annita points me toward the old supply caches and the reactor bay.");
  }
}