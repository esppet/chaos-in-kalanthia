// ROOM 50 — Earth tribunal (Act 3)

function room_AfterFadeIn()
{
  gCurrentAct = ACT_EARTH;
  player.Say("Earth. My superiors want answers. They don't believe a word I say.");
}

function hTribunal_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("The tribunal stares at me. No survivors from Kalanthia — human or replicant.");
}

function hTribunal_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("I tell them about the meteor. They call me a terrorist.");

  if (gAnnitaOnboard && gRobertOnboard)
  {
    // Good ending branch — Annita and Robert emerge as witnesses
    Wait(60);
    player.Say("Annita steps forward with proof: debris analysis, colony records.");
    Wait(60);
    player.Say("It was a meteor. Not a bomb.");

    if (gRingGifted)
    {
      Wait(60);
      player.Say("Annita and I embrace as the tribunal falls silent.");
      gGameEnding = eEndingGoodRomance;
    }
    else
    {
      gGameEnding = eEndingGoodSurvivors;
    }
  }
  else
  {
    Wait(60);
    player.Say("No witnesses. No proof. They sentence me to the gas chamber.");
    TriggerEnding(eEndingBadGasChamber);
  }
}