// ROOM 43 — Tractor beam control room

function hTractorTerminal_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("The tractor beam control terminal. Looks like it runs on delicate electronics.");
}

function hTractorTerminal_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  if (player.HasInventory(INV_HOT_COFFEE))
  {
    player.Say("Hot coffee into the computer. Classic. The tractor beam dies.");
    player.LoseInventory(INV_HOT_COFFEE);
    gTractorDisabled = 1;
    gIconbar.Visible = true;
    player.Say("Now to find the hangar and get back to my ship.");
  }
  else
  {
    player.Say("I need something to short out the circuits. And it can't be cold.");
  }
}

function hCoffeeMachine_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("A battered coffee machine. Might still work.");
}

function hCoffeeMachine_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  if (!player.HasInventory(INV_HOT_COFFEE))
  {
    // TODO: Puzzle — find mug, activate machine, get HOT coffee (not cold)
    player.Say("Fresh coffee. Still steaming. Perfect.");
    player.GiveInventory(INV_HOT_COFFEE);
  }
}