// ROOM 12 — Zero megacomplex upper floors (Robert rescue sequence)
// TIMER: 10 minutes until building collapse

function room_AfterFadeIn()
{
  if (!gRobertRescued)
    StartZeroCollapseTimer();
}

function room_BeforeFadeOut()
{
  if (gRobertRescued)
    StopZeroCollapseTimer();
}

function hRobert_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("A boy — stranded on the top floor. Annita's son.");
}

function hRobert_Interact(Hotspot *thisHotspot, CursorMode mode)
{
  if (gRobertRescued)
  {
    player.Say("Robert is safe. We need to get out of here.");
    return;
  }

  // TODO: Add puzzle chain — clear rubble, restore power, reach Robert
  gRobertRescued = 1;
  Game.SetGlobalInt(FLAG_ROBERT_RESCUED, 1);
  StopZeroCollapseTimer();
  player.Say("I've got you, Robert. Stay close.");
}

function hCollapseZone_Look(Hotspot *thisHotspot, CursorMode mode)
{
  player.Say("The structure is groaning. This whole place is coming down.");
}